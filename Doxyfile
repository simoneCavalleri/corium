# Doxyfile for Corium C++20 Header-Only Application Runtime

PROJECT_NAME           = "Corium"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "High-Performance Zero-Heap C++20 Application Runtime"
OUTPUT_DIRECTORY       = "docs"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Inputs
INPUT                  = include/ README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.md
USE_MDFILE_AS_MAINPAGE = README.md

# C++20 & Extraction settings
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INHERIT_DOCS           = YES
INLINE_INHERITED_MEMB  = YES

# Preprocessor & Macros
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

# HTML output settings
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

# Exclude LaTeX/RTF/XML
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
